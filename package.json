{
  "name": "@abd3lraouf-studios/app-store-connect-mcp",
  "version": "1.0.0",
  "description": "App Store Connect + App Store Server (StoreKit 2) MCP server. Keychain-backed credentials, full API coverage through parameterised dispatch, write-safety gating, stdio and HTTP transports.",
  "type": "module",
  "bin": {
    "asc-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "spec"
  ],
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "build": "npm run build:index && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "fetch:specs": "node scripts/fetch-specs.mjs",
    "verify": "node scripts/verify-apis.mjs",
    "build:types": "npx -y openapi-typescript@7 spec/apple-openapi.json -o spec/apple-api.d.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abd3lraouf-studios/app-store-connect-mcp.git"
  },
  "keywords": [
    "mcp",
    "app-store-connect",
    "appstoreconnect",
    "storekit",
    "app-store-server-api",
    "ios",
    "apple"
  ]
}
