{
  "name": "@abd3lraouf-studios/app-store-connect-mcp",
  "version": "1.0.0",
  "description": "App Store Connect + App Store Server (StoreKit 2) MCP server. Keychain-backed credentials, full API coverage through parameterised dispatch, write-safety gating, stdio and HTTP transports.",
  "type": "module",
  "bin": {
    "asc-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "spec"
  ],
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "build": "npm run build:index && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "fetch:specs": "node scripts/fetch-specs.mjs",
    "verify": "node scripts/verify-apis.mjs",
    "build:types": "npx -y openapi-typescript@7 spec/apple-openapi.json -o spec/apple-api.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preflight": "node scripts/preflight-release.mjs",
    "lint": "eslint src test scripts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "msw": "^2.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abd3lraouf-studios/app-store-connect-mcp.git"
  },
  "keywords": [
    "mcp",
    "app-store-connect",
    "appstoreconnect",
    "storekit",
    "app-store-server-api",
    "ios",
    "apple"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
